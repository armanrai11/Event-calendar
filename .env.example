# Copy this file to .env if you have your own MongoDB
# Example for local MongoDB:  MONGO_URI=mongodb://127.0.0.1:27017/eventdb
# Example for MongoDB Atlas:  MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/eventdb
# If you leave MONGO_URI empty, the app starts a built-in in-memory MongoDB automatically.
MONGO_URI=
PORT=3000
